# Copy to .env and fill in. .env is gitignored and MUST NOT ship in the client bundle.
# In production these live ONLY on the FastAPI proxy server (see DECISIONS.md D-12).

# Tier-3 AI provider (server-side only)
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile

# Server (Phase 3+)
DATABASE_URL=postgresql://user:pass@localhost:5432/gstreg
JWT_SIGNING_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=exchange
R2_PREFIX=utility
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
